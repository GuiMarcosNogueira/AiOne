# escape=`
FROM golang:1.24-windowsservercore-ltsc2022 AS build
WORKDIR C:\src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o C:\out\ai-aggregator.exe ./cmd/server

FROM mcr.microsoft.com/windows/nanoserver:ltsc2022
WORKDIR C:\app
COPY --from=build C:\out\ai-aggregator.exe C:\app\ai-aggregator.exe
EXPOSE 8080
ENV HTTP_PORT=8080
ENTRYPOINT ["C:\\app\\ai-aggregator.exe"]
