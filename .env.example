# Rename to .env and fill with your real credentials before running the server
HTTP_PORT=8080
LOG_LEVEL=info

OPENAI_API_KEY=replace-me
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TIMEOUT=30

GEMINI_API_KEY=replace-me
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=imagen-3.0-generate
GEMINI_VIDEO_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDINGS_MODEL=text-embedding-004
GEMINI_TIMEOUT=30

DATABASE_URL=postgres://aione:aione@localhost:5432/aione?sslmode=disable
REDIS_ADDR=localhost:6379
PROVIDER_STRATEGY=first
GENERIC_PROVIDER_CONFIG_DIR=internal/providers/config

# Auth module configuration (required to expose /auth/* endpoints)
AUTH_ACCESS_SECRET=replace-me
AUTH_REFRESH_SECRET=replace-me-too
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL=604800
AUTH_SESSION_PREFIX=auth:session
AUTH_SESSION_REDIS_ADDR=localhost:6379
AUTH_SESSION_REDIS_PASSWORD=
AUTH_SESSION_REDIS_DB=1
AUTH_RATELIMIT_WINDOW=60
AUTH_RATELIMIT_MAX_ATTEMPTS=5
AUTH_RATELIMIT_REDIS_ADDR=localhost:6379
AUTH_RATELIMIT_REDIS_PASSWORD=
AUTH_RATELIMIT_REDIS_DB=2
AUTH_ARGON_MEMORY=65536
AUTH_ARGON_ITERATIONS=3
AUTH_ARGON_PARALLELISM=2
AUTH_ARGON_SALT_LENGTH=16
AUTH_ARGON_KEY_LENGTH=32
